# Copy to .env and fill in your credentials from the ProjectX Dashboard.
# https://gateway.docs.projectx.com/docs/getting-started/authenticate/authenticate-api-key

PROJECTX_USERNAME=your_username
PROJECTX_API_KEY=your_api_key

# mock = fake accounts for UI dev (default); live = real ProjectX / TopstepX data
# TOPHAT_BROKER=live
# TOPHAT_HOST=127.0.0.1
# TOPHAT_PORT=8800
# TOPHAT_HTTPS=1
# PROJECTX_API_URL=https://api.topstepx.com
# PROJECTX_RTC_URL=https://rtc.topstepx.com
# PROJECTX_NQ_SYMBOL=F.US.ENQ
